@page
@{
    ViewData["Title"] = "Download";
}

<section class="content-page download-page">
    <div class="download-hero">
        <div class="download-copy">
            <p class="eyebrow">Closed Alpha</p>
            <h1>LIGHT FACTORY LAUNCHER</h1>
            <p class="download-version">Closed Alpha 0.2</p>
            <p class="muted">
                Первый публичный установочный пакет лаунчера LiteFactory для Windows x64.
                Рекомендуемый вариант — обычный Windows installer со Start Menu и uninstall
                support. Лаунчер включает необходимый .NET runtime и сам подготавливает
                игровые компоненты, когда они понадобятся для PLAY.
            </p>

            <div class="download-actions">
                <a class="button primary"
                   href="https://github.com/nisshaAL/LiteFactoryLauncher/releases/download/launcher-alpha-0.2/LiteFactoryLauncher-Setup-Alpha-0.2.exe">
                    DOWNLOAD FOR WINDOWS
                </a>
                <a class="button secondary compact"
                   href="https://github.com/nisshaAL/LiteFactoryLauncher/releases/download/launcher-alpha-0.2/LiteFactoryLauncher-Alpha-0.2-win-x64.zip">
                    PORTABLE VERSION
                </a>
                <a class="button secondary"
                   href="https://github.com/nisshaAL/LiteFactoryLauncher/releases/tag/launcher-alpha-0.2"
                   target="_blank"
                   rel="noopener noreferrer">
                    VIEW RELEASE ON GITHUB
                </a>
            </div>

            <div class="download-meta" aria-label="Download details">
                <span>Recommended</span>
                <span>Windows x64</span>
                <span>Installer</span>
                <span>~56 MB</span>
            </div>
        </div>

        <aside class="download-card" aria-label="Launcher release status">
            <span class="status-badge">CLOSED ALPHA</span>
            <h2>Alpha 0.2</h2>
            <p>
                Это ранняя тестовая версия. Возможны ошибки, шероховатости интерфейса
                и предупреждения Windows о новой или неподписанной программе.
            </p>
            <p>
                Если Windows показывает предупреждение, проверьте, что файл скачан
                с официального GitHub Release LiteFactory перед запуском.
            </p>
        </aside>
    </div>

    <div class="download-grid">
        <article class="feature-card">
            <p class="eyebrow">Installation</p>
            <h2>Как начать</h2>
            <ol class="install-steps">
                <li>Download the Windows installer.</li>
                <li>Run <span>LiteFactoryLauncher-Setup-Alpha-0.2.exe</span>.</li>
                <li>Complete the installation.</li>
                <li>Launch LiteFactory Launcher.</li>
                <li>Sign in with a LiteFactory account.</li>
                <li>Press PLAY.</li>
            </ol>
            <p class="muted download-note">
                The launcher handles normal game preparation automatically when needed.
            </p>
        </article>

        <article class="feature-card">
            <p class="eyebrow">Portable</p>
            <h2>ZIP version</h2>
            <p class="muted">
                Portable does not require installation. Download the ZIP, extract it,
                then run <strong>LiteFactoryLauncher.exe</strong>.
            </p>
            <div class="download-meta secondary-meta" aria-label="Portable download details">
                <span>Windows x64</span>
                <span>Portable</span>
                <span>~79 MB</span>
            </div>
        </article>
    </div>

    <article class="feature-card checksum-card">
        <p class="eyebrow">Verification</p>
        <h2>SHA-256</h2>
        <div class="checksum-grid">
            <div>
                <p class="muted">Installer SHA-256:</p>
                <code class="checksum-block">A50FFD23BB92ED9DC64C3EE3DA4E5455C49FD4FDDA8038F3831FA42EF84B8AAA</code>
            </div>
            <div>
                <p class="muted">Portable SHA-256:</p>
                <code class="checksum-block">D0FA815087ACC18329FC566E6EC32A5FFFC8DDC5ADC0E8809D025759AA20FD46</code>
            </div>
        </div>
    </article>
</section>
