@page
@model LiteFactoryWeb.Pages.PacksModel
@{
    ViewData["Title"] = "Сборки";
}

<section class="content-page">
    <div class="section-heading">
        <p class="eyebrow">Каталог</p>
        <h1>СБОРКИ</h1>
        <p class="muted">Сборки экосистемы LiteFactory.</p>
    </div>

    <div class="pack-catalog">
        <article class="pack-card">
            <div class="pack-artwork">
                <img src="~/images/light-factory-hero.png" alt="Light Factory industrial artwork" />
            </div>
            <div class="pack-content">
                <div class="pack-title-row">
                    <div>
                        <p class="eyebrow">Первый пак</p>
                        <h2>LIGHT FACTORY</h2>
                    </div>
                    <span class="status-badge">DEVELOPMENT</span>
                </div>

                <p class="muted">
                    Техническая индустриальная сборка про автоматизацию, машины, энергию,
                    хранение ресурсов и производственные цепочки.
                </p>

                <div class="spec-grid pack-specs">
                    <div><span>Minecraft</span><strong>1.12.2</strong></div>
                    <div><span>Forge</span><strong>14.23.5.2860</strong></div>
                    <div><span>Version</span><strong>0.1.1</strong></div>
                </div>

                <div class="tag-row" aria-label="Технологии сборки">
                    <span>INDUSTRIAL</span>
                    <span>AUTOMATION</span>
                    <span>ENERGY</span>
                    <span>STORAGE</span>
                    <span>TECH</span>
                </div>

                <p class="future-note">
                    Экосистема сборки развивается вокруг IndustrialCraft 2, Thermal Expansion,
                    Applied Energistics 2 и дополнительных технических модулей.
                </p>

                <div class="pack-actions">
                    <button class="button primary" type="button">ПОДРОБНЕЕ</button>
                    <span class="button disabled">УСТАНОВИТЬ ЧЕРЕЗ LAUNCHER — СКОРО</span>
                </div>
            </div>
        </article>
    </div>
</section>
