@page
@model LiteFactoryWeb.Pages.PacksModel
@{
    ViewData["Title"] = "Сборки";
}

<section class="content-page">
    <div class="section-heading">
        <p class="eyebrow">Сборки</p>
        <h1>LIGHT FACTORY</h1>
        <p class="muted">Первая сборка проекта LiteFactory.</p>
    </div>

    <article class="feature-card build-card wide">
        <h2>Light Factory</h2>
        <p class="muted">Technical / industrial modpack. Automation, machines, production chains and progression.</p>
        <div class="spec-grid">
            <div><span>Minecraft</span><strong>1.12.2</strong></div>
            <div><span>Forge</span><strong>14.23.5.2860</strong></div>
            <div><span>Version</span><strong>0.1.1</strong></div>
        </div>
        <p class="future-note">Установка и обновление выполняются через LiteFactory Launcher. Публичная загрузка лаунчера будет добавлена позже.</p>
    </article>
</section>
